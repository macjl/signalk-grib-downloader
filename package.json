{
  "name": "signalk-grib-downloader",
  "version": "0.2.1",
  "description": "Orchestrates automatic or manual GRIB downloads (GFS, AROME, ARPEGE, ICON-EU) through containerised jobs — feeds signalk-grib-weather-provider",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-weather",
    "signalk",
    "weather",
    "grib",
    "grib2",
    "downloader",
    "marine"
  ],
  "author": "Jean-Laurent Girod (@macjl)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macjl/signalk-grib-downloader.git"
  },
  "homepage": "https://github.com/macjl/signalk-grib-downloader#readme",
  "bugs": {
    "url": "https://github.com/macjl/signalk-grib-downloader/issues"
  },
  "files": [
    "icon.svg",
    "dist/",
    "public/",
    "test/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "GRIB Downloader",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./public/screenshot.png"
    ]
  },
  "peerDependencies": {
    "@signalk/server-api": ">=2.0.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.25.0",
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@digitaldefiance/bzip2-wasm": "^1.1.1"
  }
}
